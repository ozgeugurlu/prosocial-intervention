# Copy to .env.local and fill in from Firebase console → Project settings → Your apps (Web app config).
# These are client identifiers, not secrets; access is enforced by firestore.rules.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=marsh-prosocial-intervention.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=marsh-prosocial-intervention
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=marsh-prosocial-intervention.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
